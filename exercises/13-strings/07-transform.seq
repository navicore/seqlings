# Exercise: String Transformation
#
# `string.to-upper` converts to uppercase.
# `string.to-lower` converts to lowercase.
# `string.trim` removes leading/trailing whitespace.
#
# Stack effect: ( str -- str )
#
# Example:
#   "Hello" string.to-upper   # "HELLO"
#   "Hello" string.to-lower   # "hello"
#   "  hi  " string.trim      # "hi"
#
# Your task: Two transforms on different inputs:
#   1. Convert "seq" to uppercase ("SEQ")
#   2. Trim "  hello  " down to "hello"
# Each transform has its own "Your code here" block below.
# When done, delete the marker line below.

# I AM NOT DONE

: test-transform ( -- )
    # --- Transform 1: convert "seq" to uppercase ---
    # Your code here.
    # Replace `""` with the transform:
    ""
    "SEQ" string.equal? test.assert    # do not edit — asserts the value above

    # --- Transform 2: trim whitespace from "  hello  " ---
    # Your code here.
    # Replace `""` with the transform:
    ""
    "hello" string.equal? test.assert  # do not edit — asserts the value above
;
