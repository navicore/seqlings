# Exercise: Writing Output
#
# `io.write-line` prints a string followed by a newline.
#
# Stack effect:
#   io.write-line ( str -- )
#
# Example:
#   "Hello, World!" io.write-line
#
# Your task: Print "Seq is fun!" to the console.
#
# The test below only checks that `greet` runs — it doesn't inspect
# what got written. To actually see the output, drop your code into
# a tiny shebang script:
#
#   #!/usr/bin/env seqc
#   : main ( -- ) "Seq is fun!" io.write-line ;
#
#   $ chmod +x hello.seq
#   $ ./hello.seq
#   Seq is fun!
#
# (Or for a one-liner, paste `"Seq is fun!" io.write-line` into
#  `seqc repl`.)
#
# When done, delete the marker line below.

# I AM NOT DONE

: greet ( -- )
    # Your code here
    "placeholder" io.write-line
;

: test-write-line ( -- )
    # We can't easily test output, so just verify the word runs
    greet
    # Do not edit below this line
    true test.assert
;
