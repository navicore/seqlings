# Exercise: Handling EOF
#
# `io.read-line+` returns both the line AND a success status.
#
# Stack effect: ( -- String Bool )
#   Returns ( line true ) on success
#   Returns ( "" false ) on EOF
#
# This allows you to detect end-of-file:
#
#   io.read-line+ [
#       # Got a line, process it
#   ] [
#       drop  # Drop the empty string
#       # Handle EOF
#   ] if
#
# Your task: Understand EOF handling.
#
# Like the previous exercise, the auto-test can't drive stdin.
# To watch EOF detection actually work, paste a loop into the
# REPL and end input with Ctrl-D:
#
#   $ seqc repl
#   > [ io.read-line+ ] [ io.write-line ] while drop
#   one
#   one
#   two
#   two
#   ^D
#
# When done, delete the marker line below.

# I AM NOT DONE

: process-until-eof ( -- )
    # Would process lines until EOF
    # [ io.read-line+ ]
    # [ io.write-line true ]
    # while
    # drop  # Drop final false/empty
    "EOF handling concept" io.write-line
;

: test-read-status ( -- )
    true test.assert
;
