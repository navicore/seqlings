: test-gzip ( -- )
    # Test compression
    "Hello, World!" gzip-compress
    # Do not edit below this line
    test.assert
    # Result is base64-encoded, so not empty
    string.length 0 i.> test.assert

    # Test roundtrip
    "Seq compression test!" gzip-compress
    test.assert
    gzip-decompress
    test.assert
    "Seq compression test!" test.assert-eq-str
;
