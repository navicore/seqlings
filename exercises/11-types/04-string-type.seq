# Exercise: String Operations
#
# Strings are sequences of characters. String operations:
#   string.length    - Get length (number of characters)
#   string.concat    - Join two strings
#   string.equal?    - Check if two strings are equal
#   string.empty?    - Check if string is empty
#
# Your task: Work with string operations
# When done, delete the marker line below.

# I AM NOT DONE

: test-string-length ( -- )
    # Get the length of "hello"
    # Your code here - get its length.
    0
    # Do not edit below this line
    5 test.assert-eq
;

: test-string-concat ( -- )
    # Concatenate "hello" and " world"
    # Your code here
    ""
    # Do not edit below this line
    "hello world" string.equal? test.assert
;

: test-string-empty ( -- )
    # Check if "" is empty (returns true)
    # Your code here - test whether the string is empty.
    false
    # Do not edit below this line
    test.assert
;

: test-string-not-empty ( -- )
    # Check that "hi" is not empty (returns false)
    # Your code here - test whether the string is empty.
    true
    # Do not edit below this line
    not test.assert
;
