# Exercise: Append
#
# `append` concatenates two lists end-to-end. Definition:
#
#   append(empty, ys)             = ys
#   append(prepend x xs, ys)      = prepend x (append xs ys)
#
# Two things to notice:
#
# 1. Unlike `length` and `reverse`, `append` doesn't use an
#    accumulator. The recursive call returns the partially-appended
#    result, and we prepend the saved head onto it on the way back.
#
# 2. That "save the head, recurse, prepend on the way back"
#    pattern needs us to keep the head alive *across* a recursive
#    call. That's exactly what `dip` (chapter 37) is for: hide the
#    top, run the quotation, restore the top. The hint file shows
#    the exact shape if you get stuck.
#
# Your task: Define
#
#   append ( ListA ListB -- List )
#
# When done, delete the marker line below.

# I AM NOT DONE

# ─── Already defined for you ───────────────────────────────────
: empty ( -- Variant )         :Empty variant.make-0 ;
: prepend ( T Variant -- Variant ) :Cons variant.make-2 ;
: empty? ( Variant -- Bool )    variant.tag :Empty symbol.= ;
: head ( Variant -- T )         0 variant.field-at ;
: tail ( Variant -- Variant )      1 variant.field-at ;
: length-acc ( Variant Int -- Int )
    swap dup empty? [ drop ] [ tail swap 1 i.+ length-acc ] if
;
: length ( Variant -- Int ) 0 length-acc ;
# ───────────────────────────────────────────────────────────────

: append ( Variant Variant -- Variant )
    # Your code here — recurse on the first list.
    #   - if list A is empty, the result is just list B
    #   - otherwise, save the head of A, recurse on (tail-of-A, B),
    #     then prepend the saved head onto the result
    # The "save head across a recursive call" part is what `dip`
    # (chapter 37) was built for. Exact stack shape in the hint file.
    nip
;

# Do not edit below this line

: test-append-empty-left ( -- )
    empty
    empty 2 swap prepend 1 swap prepend
    append length 2 test.assert-eq
;

: test-append-empty-right ( -- )
    empty 2 swap prepend 1 swap prepend
    empty
    append length 2 test.assert-eq
;

: test-append-head ( -- )
    # (1 2) ++ (3 4) → (1 2 3 4); head should be 1
    empty 2 swap prepend 1 swap prepend
    empty 4 swap prepend 3 swap prepend
    append head 1 test.assert-eq
;

: test-append-length ( -- )
    empty 2 swap prepend 1 swap prepend
    empty 4 swap prepend 3 swap prepend
    append length 4 test.assert-eq
;
