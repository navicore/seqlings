# Exercise: Removing Map Entries
#
# Use `map.remove` to delete a key-value pair from a map.
# Use `map.has?` to check if a key exists.
#
# Example:
#   my-map "key" map.remove    # Returns map without that key
#   my-map "key" map.has?      # Returns Bool: true if present
#
# Your task: Remove entries and verify they're gone.
#
# When done, delete the marker line below.

# I AM NOT DONE

: make-test-map ( -- Variant )
    map.make
    "a" 1 map.set
    "b" 2 map.set
    "c" 3 map.set
;

: test-remove ( -- )
    make-test-map
    # Remove key "b" so the next line sees the post-removal map
    # Your code here

    # Do not edit below this line
    "b" map.has? test.assert-not
;

: test-contains ( -- )
    make-test-map
    # Check that "a" exists (without removing it)
    # Your code here
    drop false

    # Do not edit below this line
    test.assert
;
