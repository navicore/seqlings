# Exercise: Combining Math Operations
#
# Compose multiple `std:imath` functions.
#
# Your task: implement two combinations — Manhattan distance
# and a bounded power.
#
# When done, delete the marker line below.

include std:imath

# I AM NOT DONE

: manhattan-distance ( Int Int Int Int -- Int )
    # Manhattan distance between (x1,y1) and (x2,y2):
    # |x2 - x1| + |y2 - y1|
    # Stack: x1 y1 x2 y2  (y2 on top)
    # Your code here
    drop drop drop drop 0
;

# seq:allow(unchecked-i-pow)
: bounded-power ( Int Int Int Int -- Int )
    # base^exp, clamped to [min, max]
    # Stack: base exp min max  (max on top)
    #
    # Hint: `>aux` moves the top of the stack to a word-local
    # aux stack; `aux>` moves it back. Stashing min and max to
    # aux frees the main stack for the `i.pow` call (remember to
    # drop its success Bool), after which you can restore min
    # and max and call `clamp`.
    # Your code here
    drop drop drop drop 0
;

# Do not edit below this line

: test-manhattan ( -- )
    0 0 3 4 manhattan-distance
    7 test.assert-eq
;

: test-bounded-power ( -- )
    # 2^10 = 1024, clamped to [0, 500] → 500
    2 10 0 500 bounded-power
    500 test.assert-eq
;
