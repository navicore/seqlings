# Exercise: Clamping Values
#
# `clamp` constrains a value to a range [min, max].
#
# Stack effect: ( value min max -- clamped )
#
# Examples:
#   15 0 10 clamp    # value > max → returns 10
#   -5 0 10 clamp    # value < min → returns 0
#    5 0 10 clamp    # in range  → returns 5
#
# Your task: Clamp a percentage to the valid range [0, 100].
#
# When done, delete the marker line below.

include std:imath

# I AM NOT DONE

: clamp-percent ( Int -- Int )
    # Clamp to range 0-100
    # Your code here
    drop 0
;

# Do not edit below this line

: test-clamp-high ( -- )
    150 clamp-percent
    100 test.assert-eq
;

: test-clamp-low ( -- )
    -20 clamp-percent
    0 test.assert-eq
;

: test-clamp-ok ( -- )
    50 clamp-percent
    50 test.assert-eq
;
