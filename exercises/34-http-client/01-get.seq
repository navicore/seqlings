# Exercise: HTTP GET Requests
#
# net.http.get ( String -- Map )
#
# Returns a map with:
#   "ok"     - Bool: true if successful
#   "status" - Int: HTTP status code
#   "body"   - String: response body
#   "error"  - String: error message (if failed)
#
# Your task: Extract data from HTTP responses
# When done, delete the marker line below.

# I AM NOT DONE

: response-ok? ( Variant -- Bool )
    # Check if response was successful
    # Your code here
    drop false
;

: response-body ( Variant -- String )
    # Get the response body (or empty string if failed)
    # Your code here
    drop ""
;

: response-status ( Variant -- Int )
    # Get the HTTP status code
    # Your code here
    drop 0
;

: test-get ( -- )
    # Simulate a successful response
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "Hello, World!" map.set
    # Do not edit below this line

    dup response-ok?
    test.assert

    dup response-status
    200 test.assert-eq

    response-body
    "Hello, World!" test.assert-eq-str

    # Simulate a failed response
    map.make
        "ok" false map.set
        "status" 404 map.set
        "error" "Not Found" map.set
        "body" "" map.set

    dup response-ok?
    not test.assert

    dup response-status
    404 test.assert-eq

    response-body
    "" test.assert-eq-str
;
