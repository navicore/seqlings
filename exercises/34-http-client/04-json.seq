# Exercise: Working with JSON APIs
#
# Most modern APIs return JSON. Combine HTTP client with
# JSON parsing to build useful API clients.
#
# Pattern:
#   1. Make HTTP request
#   2. Check for success
#   3. Parse JSON body (succeeds → Variant Bool=true; fails → garbage False)
#
# JSON parsing returns a Variant tagged as a JsonObject/Array/etc.,
# not a Seq `Map`. Drilling into specific fields uses the
# `variant.field-at` API or the predicates in `std:json` — outside
# this exercise's scope. Here we only check that parsing succeeds
# for well-formed input and fails for malformed input.
#
# Your task: Build `api-success?` (checks `ok` and `status` keys)
# and `get-json-body` (parse the `body` field as JSON).
#
# When done, delete the marker line below.

include std:json

# I AM NOT DONE

: api-success? ( Variant -- Bool )
    # Check if API call succeeded (ok=true and status=200)
    # Your code here
    drop false
;

: get-json-body ( Variant -- Variant Bool )
    # Get parsed JSON from response body
    # Returns: ( parsed-value success )
    # Your code here
    drop map.make false
;

: test-json ( -- )
    # Successful API response with JSON body
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "{\"user\":\"alice\",\"id\":42}" map.set
    # Do not edit below this line

    dup api-success?
    test.assert

    get-json-body
    test.assert     # JSON parsing should succeed
    drop            # discard the parsed Variant

    # Failed API response
    map.make
        "ok" false map.set
        "status" 500 map.set
        "error" "Server Error" map.set
        "body" "" map.set

    api-success?
    not test.assert

    # Response with invalid JSON
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "not valid json" map.set

    get-json-body
    not test.assert   # JSON parsing should fail
    drop              # discard the dummy Variant
;
