# Exercise: Working with JSON APIs
#
# `include std:json` brings in `json-parse`:
#
#   json-parse ( String -- Variant Bool )
#     Parses a JSON string. Returns the parsed value and a
#     success Bool (false on malformed input).
#
# The parsed value is a Variant tagged as JsonObject / JsonArray /
# etc. — *not* a Seq `Map`, so you can't drill into its fields with
# `map.get`. (Field access uses `variant.field-at` and the predicates
# in `std:json`, outside this exercise's scope.) Here we only check
# that parsing succeeds for well-formed input and fails otherwise.
#
# Your task:
#   - `api-success?`  — true when the response Map has `ok=true`
#                       AND `status=200` (use `map.get` from ch 16)
#   - `get-json-body` — pull the `body` String from the Map and
#                       hand it to `json-parse`
#
# When done, delete the marker line below.

include std:json

# I AM NOT DONE

: api-success? ( Variant -- Bool )
    # Check if API call succeeded (ok=true and status=200)
    # Your code here
    drop false
;

: get-json-body ( Variant -- Variant Bool )
    # Get parsed JSON from response body
    # Returns: ( parsed-value success )
    # Your code here
    drop map.make false
;

: test-json ( -- )
    # Successful API response with JSON body
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "{\"user\":\"alice\",\"id\":42}" map.set
    # Do not edit below this line

    dup api-success?
    test.assert

    get-json-body
    test.assert     # JSON parsing should succeed
    drop            # discard the parsed Variant

    # Failed API response
    map.make
        "ok" false map.set
        "status" 500 map.set
        "error" "Server Error" map.set
        "body" "" map.set

    api-success?
    not test.assert

    # Response with invalid JSON
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "not valid json" map.set

    get-json-body
    not test.assert   # JSON parsing should fail
    drop              # discard the dummy Variant
;
