# Exercise: Mathematical Formulas
#
# Combine float builtins to implement common formulas.
#
# The "approximately equal" pattern uses `f.abs` from
# `std:fmath` — the only word in this exercise that needs the
# include. (The builtin `f.sqrt`, `f.pi`, etc. are always
# available.)
#
# Your tasks: implement `circle-area`, `degrees-to-radians`,
# and `distance`.
#
# When done, delete the marker line below.

include std:fmath

# I AM NOT DONE

: circle-area ( Float -- Float )
    # Area of circle: pi * r^2
    # Your code here
    drop 0.0
;

: test-circle-area ( -- )
    # Area of circle with radius 2 is ~12.566...
    2.0 circle-area

    # Do not edit below this line
    12.566 f.- f.abs 0.01 f.< test.assert
;

: degrees-to-radians ( Float -- Float )
    # Convert degrees to radians: degrees * pi / 180
    # Your code here
    drop 0.0
;

: test-degrees ( -- )
    # 180 degrees = pi radians
    180.0 degrees-to-radians

    # Do not edit below this line
    f.pi f.- f.abs 0.0001 f.< test.assert
;

: distance ( Float Float Float Float -- Float )
    # Euclidean distance between (x1,y1) and (x2,y2):
    # sqrt((x2-x1)^2 + (y2-y1)^2)
    # Your code here
    drop drop drop drop 0.0
;

: test-distance ( -- )
    0.0 0.0 3.0 4.0 distance

    # Do not edit below this line
    5.0 f.= test.assert
;
