# Exercise: Trigonometric Functions
#
# The trig builtins take their argument in radians:
#
#   f.sin    ( Float -- Float )    sine
#   f.cos    ( Float -- Float )    cosine
#   f.tan    ( Float -- Float )    tangent
#
# Inverse forms `f.asin`, `f.acos`, `f.atan` also exist, plus
# `f.atan2 ( y x -- result )` for the angle from origin to a
# point.
#
# `f.pi` is the constant. No include needed for any of these —
# all builtins.
#
# Your tasks:
#   - In `test-cos-zero`, compute cos(0) and let the assertion
#     verify it equals 1.0.
#   - In `test-sin-pi-half`, compute sin(π/2) and assert it
#     equals 1.0.
#
# When done, delete the marker line below.

# I AM NOT DONE

: test-sin-zero ( -- )
    0.0 f.sin

    # Do not edit below this line (sin(0) = 0)
    0.0 f.= test.assert
;

: test-cos-zero ( -- )
    # cos(0) = 1
    # Your code here
    0.0

    # Do not edit below this line
    1.0 f.= test.assert
;

: test-sin-pi-half ( -- )
    # sin(π/2) = 1 — `f.pi 2.0 f./` is π/2
    # Your code here
    0.0

    # Do not edit below this line
    1.0 f.= test.assert
;
