# Exercise: Exponential and Logarithmic
#
# Builtins:
#
#   f.exp     ( Float -- Float )           e^x
#   f.ln      ( Float -- Float )           natural log (base e)
#   f.log10   ( Float -- Float )           log base 10
#   f.log2    ( Float -- Float )           log base 2
#   f.pow     ( Float Float -- Float )     base^exp
#
# `f.pow` argument order is `base exp` — `2.0 8.0 f.pow` is 2⁸.
#
# Errors are IEEE 754 values: `f.ln 0.0` is `-Infinity`, not a
# flag. `f.ln` of a negative is `NaN`.
#
# Your tasks: fill in `test-log10` (log₁₀ 100 = 2) and `test-pow`
# (2⁸ = 256).
#
# When done, delete the marker line below.

# I AM NOT DONE

: test-exp-zero ( -- )
    # e^0 = 1
    0.0 f.exp

    # Do not edit below this line
    1.0 f.= test.assert
;

: test-ln-e ( -- )
    # ln(e) = 1
    f.e f.ln

    # Do not edit below this line
    1.0 f.= test.assert
;

: test-log10 ( -- )
    # log10(100) = 2
    # Your code here
    0.0

    # Do not edit below this line
    2.0 f.= test.assert
;

: test-pow ( -- )
    # 2^8 = 256
    # Your code here
    0.0

    # Do not edit below this line
    256.0 f.= test.assert
;
