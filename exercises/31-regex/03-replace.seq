: test-replace ( -- )
    # Censor numbers
    "Call 555-1234 or 555-5678" censor-numbers
    # Do not edit below this line
    "Call XXX-XXXX or XXX-XXXX" test.assert-eq

    # Normalize whitespace
    "hello    world   test" normalize-whitespace
    "hello world test" test.assert-eq

    # Tabs too
    "a\tb\t\tc" normalize-whitespace
    "a b c" test.assert-eq
;
