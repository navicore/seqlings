: test-validate ( -- )
    # Email validation
    "user@example.com" valid-email?
    # Do not edit below this line
    test.assert

    "invalid.email" valid-email?
    not test.assert

    # Phone validation (simplified - just 10 digits)
    "5551234567" valid-phone?
    test.assert

    "555" valid-phone?
    not test.assert

    # Username validation
    "john_doe123" valid-username?
    test.assert

    "ab" valid-username?
    not test.assert

    "123user" valid-username?
    not test.assert
;
