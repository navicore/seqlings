    # Your code here
    drop false
;

: valid-phone? ( String -- Bool )
    # US phone: 123-456-7890 or (123) 456-7890
    # Simplified: just check for 10 digits
    # Your code here
    drop false
;

: valid-username? ( String -- Bool )
    # Username: 3-16 alphanumeric chars, may include underscore
