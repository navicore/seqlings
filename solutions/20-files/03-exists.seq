: present? ( String -- String )
    file.exists?
    [ "yes" ]
    [ "no" ]
    if
;

: test-exists-yes ( -- )
    "exercises/20-files/data/greeting.txt" present?
    "yes" string.equal? test.assert
;

: test-exists-no ( -- )
    "/no/such/path/seqlings-bogus-9c7f.txt" present?
    "no" string.equal? test.assert
;
