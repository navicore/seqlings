: hash-message ( String -- String )
    crypto.sha256
;

: same-hash? ( String String -- Bool )
    crypto.sha256
    swap crypto.sha256
    =
;

: test-sha256 ( -- )
    "hello" hash-message
    string.length 64 test.assert-eq

    "test" "test" same-hash?
    test.assert

    "hello" "Hello" same-hash?
    not test.assert

    "" hash-message
    string.length 64 test.assert-eq
;
