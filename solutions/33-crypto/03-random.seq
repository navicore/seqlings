: generate-token ( Int -- String )
    crypto.random-bytes
;

: generate-uuid ( -- String )
    crypto.uuid4
;

: test-random ( -- )
    16 generate-token
    string.length 32 test.assert-eq

    32 generate-token
    string.length 64 test.assert-eq

    16 generate-token
    16 generate-token
    = not test.assert

    generate-uuid
    string.length 36 test.assert-eq

    generate-uuid
    generate-uuid
    = not test.assert
;
