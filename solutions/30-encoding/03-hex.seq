: to-hex ( String -- String )
    encoding.hex-encode
;

: from-hex ( String -- String Bool )
    encoding.hex-decode
;

: test-hex ( -- )
    "Hello" to-hex
    "48656c6c6f" test.assert-eq

    "576f726c64" from-hex
    test.assert
    "World" test.assert-eq

    "48454C4C4F" from-hex
    test.assert
    "HELLO" test.assert-eq

    "A" to-hex
    "41" test.assert-eq
;
