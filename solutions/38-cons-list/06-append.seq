: empty ( -- Variant )         :Empty variant.make-0 ;
: prepend ( T Variant -- Variant ) :Cons variant.make-2 ;
: empty? ( Variant -- Bool )    variant.tag :Empty symbol.= ;
: head ( Variant -- T )         0 variant.field-at ;
: tail ( Variant -- Variant )      1 variant.field-at ;
: length-acc ( Variant Int -- Int )
    swap dup empty? [ drop ] [ tail swap 1 i.+ length-acc ] if
;
: length ( Variant -- Int ) 0 length-acc ;

: append ( Variant Variant -- Variant )
    over empty? [
        nip
    ] [
        over head
        rot tail rot
        rot
        [ append ] dip
        swap prepend
    ] if
;

: test-append-empty-left ( -- )
    empty
    empty 2 swap prepend 1 swap prepend
    append length 2 test.assert-eq
;

: test-append-empty-right ( -- )
    empty 2 swap prepend 1 swap prepend
    empty
    append length 2 test.assert-eq
;

: test-append-head ( -- )
    empty 2 swap prepend 1 swap prepend
    empty 4 swap prepend 3 swap prepend
    append head 1 test.assert-eq
;

: test-append-length ( -- )
    empty 2 swap prepend 1 swap prepend
    empty 4 swap prepend 3 swap prepend
    append length 4 test.assert-eq
;
