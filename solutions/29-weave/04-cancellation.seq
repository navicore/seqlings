# Simple counter that counts 0, 1, 2, 3... forever
# Ignores the resume value, just increments
: counter ( T Int -- | Yield Int )
    tuck           # ( count T count )
    yield          # yield count, receive new value -> ( count T _ )
    drop           # drop resume value -> ( count T )
    swap           # ( T count )
    1 i.add        # ( T count+1 )
    counter        # tail recurse
;

: test-cancellation ( -- )
    [ counter ] strand.weave

    0 strand.resume
    test.assert
    0 test.assert-eq

    0 strand.resume
    test.assert
    1 test.assert-eq

    0 strand.resume
    test.assert
    2 test.assert-eq

    strand.weave-cancel

    true test.assert
;

: test-cancel-before-resume ( -- )
    [ counter ] strand.weave
    strand.weave-cancel

    true test.assert
;
