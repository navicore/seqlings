: response-ok? ( Variant -- Bool )
    "ok" map.get drop
;

: response-body ( Variant -- String )
    dup response-ok? [
        "body" map.get drop
    ] [
        drop ""
    ] if
;

: response-status ( Variant -- Int )
    "status" map.get drop
;

: test-get ( -- )
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "Hello, World!" map.set

    dup response-ok?
    test.assert

    dup response-status
    200 test.assert-eq

    response-body
    "Hello, World!" test.assert-eq-str

    map.make
        "ok" false map.set
        "status" 404 map.set
        "error" "Not Found" map.set
        "body" "" map.set

    dup response-ok?
    not test.assert

    dup response-status
    404 test.assert-eq

    response-body
    "" test.assert-eq-str
;
