include std:json

: api-success? ( Variant -- Bool )
    dup "ok" map.get drop
    swap "status" map.get drop
    200 i.= and
;

: get-json-body ( Variant -- Variant Bool )
    "body" map.get drop
    json-parse
;

: test-json ( -- )
    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "{\"user\":\"alice\",\"id\":42}" map.set

    dup api-success?
    test.assert

    get-json-body
    test.assert
    drop

    map.make
        "ok" false map.set
        "status" 500 map.set
        "error" "Server Error" map.set
        "body" "" map.set

    api-success?
    not test.assert

    map.make
        "ok" true map.set
        "status" 200 map.set
        "body" "not valid json" map.set

    get-json-body
    not test.assert
    drop
;
