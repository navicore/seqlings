include std:imath

: manhattan-distance ( Int Int Int Int -- Int )
    rot i.- abs
    rot rot i.- abs
    i.+
;

: test-manhattan ( -- )
    0 0 3 4 manhattan-distance
    7 test.assert-eq
;

: bounded-power ( Int Int Int Int -- Int )
    >aux >aux       # stash min and max
    pow             # base^exp
    aux> aux>       # restore min, max
    clamp
;

: test-bounded-power ( -- )
    2 10 0 500 bounded-power
    500 test.assert-eq
;
