# seq:allow(unchecked-i-pow)
: power-of-2 ( Int -- Int )
    2 swap i.pow drop
;

: test-pow ( -- )
    3 4 i.pow                 # ( 81 true )
    swap 81 test.assert-eq    # ( true ) — checks result
    test.assert               # consumes the success Bool
;

: test-power-of-2 ( -- )
    8 power-of-2
    256 test.assert-eq
;

: test-power-zero ( -- )
    0 power-of-2
    1 test.assert-eq
;
