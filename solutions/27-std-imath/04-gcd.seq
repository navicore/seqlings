include std:imath

: simplify-numerator ( Int Int -- Int )
    over over gcd       # ( num denom gcd )
    swap drop           # ( num gcd )
    i./                 # ( quot success )
    drop                # ( quot )
;

: test-gcd ( -- )
    48 18 gcd
    6 test.assert-eq
;

: test-simplify ( -- )
    12 8 simplify-numerator
    3 test.assert-eq
;
