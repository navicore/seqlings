: join-with-dash ( Variant -- String )
    "" [
        swap dup string.empty? if
            drop                              # first element: just keep it
        else
            "-" string.concat swap string.concat  # append "-elem" to acc
        then
    ] list.fold
;

: test-fold ( -- )
    "one two three" " " string.split join-with-dash
    "one-two-three" string.equal? test.assert
;
