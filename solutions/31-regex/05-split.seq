: split-csv ( String -- Variant )
    "\\s*,\\s*" regex.split drop
;

: split-sentences ( String -- Variant )
    "[.!?]+\\s*" regex.split drop
;

: test-split ( -- )
    "apple, banana,  cherry" split-csv
    list.length 3 test.assert-eq

    "Hello! How are you? I'm fine." split-sentences
    list.length 3 test.assert-eq
;
