: spawn-worker ( Channel Channel -- Channel Channel )
    [ over chan.receive drop 20 time.sleep-ms 1 i.+ swap chan.send drop drop ] strand.spawn drop
;

: test-capacity-planning ( -- )
    chan.make
    chan.make

    spawn-worker
    spawn-worker
    spawn-worker
    spawn-worker

    time.now

    10 3 pick chan.send drop
    20 3 pick chan.send drop
    30 3 pick chan.send drop
    40 3 pick chan.send drop

    1 pick chan.receive drop drop
    1 pick chan.receive drop drop
    1 pick chan.receive drop drop
    1 pick chan.receive drop drop

    time.now swap i.-
    4 1000000 i.* swap i./ drop

    nip nip

    160 i.>= test.assert
;
