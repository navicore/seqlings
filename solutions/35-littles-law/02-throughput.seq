: test-throughput ( -- )
    chan.make
    chan.make

    [ over chan.receive drop 10 time.sleep-ms 1 i.+ swap chan.send drop drop ] strand.spawn drop
    [ over chan.receive drop 10 time.sleep-ms 1 i.+ swap chan.send drop drop ] strand.spawn drop
    [ over chan.receive drop 10 time.sleep-ms 1 i.+ swap chan.send drop drop ] strand.spawn drop
    [ over chan.receive drop 10 time.sleep-ms 1 i.+ swap chan.send drop drop ] strand.spawn drop

    time.now
    # ( work results start )

    2 pick 10 swap chan.send drop
    2 pick 20 swap chan.send drop
    2 pick 30 swap chan.send drop
    2 pick 40 swap chan.send drop

    1 pick chan.receive drop drop
    1 pick chan.receive drop drop
    1 pick chan.receive drop drop
    1 pick chan.receive drop drop

    time.now swap i.-
    nip nip
    # ( elapsed )

    25000 i.< test.assert
;
