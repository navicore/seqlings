: test-measure-latency ( -- )
    chan.make
    chan.make

    [ over chan.receive drop 10 time.sleep-ms swap chan.send drop drop ] strand.spawn drop

    time.now                            # ( work results start )
    rot 1 swap chan.send drop           # ( results start )

    swap chan.receive drop drop         # ( start )
    time.now swap i.-                   # ( W )

    9000 i.> test.assert
;
