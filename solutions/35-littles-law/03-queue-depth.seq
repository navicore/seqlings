: test-queue-depth ( -- )
    chan.make   # work
    chan.make   # results

    [
        over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
        over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
        over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
        drop drop
    ] strand.spawn drop

    over 1 swap chan.send drop
    over 1 swap chan.send drop
    over 1 swap chan.send drop

    dup chan.receive drop          # ( work results val1 )
    over chan.receive drop i.+     # ( work results sum2 )
    over chan.receive drop i.+     # ( work results sum3 )

    nip nip                        # ( sum )
    6 test.assert-eq
;
