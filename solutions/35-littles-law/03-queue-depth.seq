: test-queue-depth ( -- )
    chan.make
    chan.make

    [ over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      drop drop ] strand.spawn drop

    0
    # ( work results in_flight=0 )

    1 3 pick chan.send drop 1 i.+
    2 3 pick chan.send drop 1 i.+
    3 3 pick chan.send drop 1 i.+
    4 3 pick chan.send drop 1 i.+
    # ( work results 4 )

    dup
    # ( work results peak=4 in_flight=4 )

    2 pick chan.receive drop drop 1 i.-
    2 pick chan.receive drop drop 1 i.-
    2 pick chan.receive drop drop 1 i.-
    2 pick chan.receive drop drop 1 i.-
    # ( work results peak 0 )

    drop
    nip nip
    # ( peak )

    3 i.>= test.assert
;
