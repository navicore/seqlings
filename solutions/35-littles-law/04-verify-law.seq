: test-verify-law ( -- )
    chan.make
    chan.make

    [ over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      over chan.receive drop 20 time.sleep-ms 1 i.+ over chan.send drop
      drop drop ] strand.spawn drop

    time.now

    1 3 pick chan.send drop
    2 3 pick chan.send drop
    3 3 pick chan.send drop

    0

    2 pick chan.receive drop drop time.now 2 pick i.- swap i.+
    2 pick chan.receive drop drop time.now 2 pick i.- swap i.+
    2 pick chan.receive drop drop time.now 2 pick i.- swap i.+

    time.now 2 pick i.-
    i./ drop
    nip nip nip

    dup 1 i.>= test.assert
    3 i.<= test.assert
;
