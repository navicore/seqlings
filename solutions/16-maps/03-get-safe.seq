: make-test-map ( -- Variant )
    map.make
    "name" "Bob" map.set
;

: get-or ( Variant String String -- String )
    rot rot map.get
    [ nip ]
    [ drop ]
    if
;

: test-get-existing ( -- )
    make-test-map
    "name" "Unknown" get-or
    "Bob" string.equal? test.assert
;

: test-get-missing ( -- )
    make-test-map
    "age" "Unknown" get-or
    "Unknown" string.equal? test.assert
;
