: make-test-map ( -- Variant )
    map.make
    "color" "blue" map.set
    "size" "large" map.set
;

: test-get ( -- )
    make-test-map
    "color" map.get drop
    "blue" string.equal? test.assert
;

: test-get-other ( -- )
    make-test-map
    "size" map.get drop
    "large" string.equal? test.assert
;
