: test-worker-pool ( -- )
    chan.make           # ( work )
    chan.make           # ( work results )

    [ over chan.receive drop 1 i.+ swap chan.send drop drop ] strand.spawn drop
    [ over chan.receive drop 1 i.+ swap chan.send drop drop ] strand.spawn drop

    over 10 swap chan.send drop
    over 20 swap chan.send drop

    dup chan.receive drop    # ( work results val1 )
    over chan.receive drop   # ( work results val1 val2 )
    i.+                      # ( work results sum )
    nip nip                  # ( sum )
    32 test.assert-eq
;
