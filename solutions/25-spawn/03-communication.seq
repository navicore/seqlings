: spawn-doubler ( -- Channel Channel )
    chan.make
    chan.make
    [
        # closure stack: ( request response )
        swap chan.receive drop   # receive request, drop flag: ( response val )
        2 i.*                    # ( response doubled )
        swap chan.send drop      # send doubled, drop flag: ( )
    ] strand.spawn drop          # ( request response )
;

: test-communication ( -- )
    spawn-doubler
    over 21 swap chan.send drop  # send 21: ( request response )
    chan.receive drop            # receive 42: ( request 42 )
    nip                          # ( 42 )
    42 test.assert-eq
;
