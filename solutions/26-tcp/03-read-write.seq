# seq:allow(unchecked-tcp-write)
: connector ( -- )
    "127.0.0.1" 18263 net.tcp.connect
    [ # ( socket )
      "hello" over net.tcp.write drop
      net.tcp.close drop
    ]
    [ drop ]
    if
;

: test-read-write ( -- )
    18263 net.tcp.listen
    [ # ( server )
      [ connector ] strand.spawn drop
      dup net.tcp.accept
      [ # ( server client )
        dup net.tcp.read
        [ # ( server client data )
          "hello" test.assert-eq-str
        ]
        [ drop ]
        if
        net.tcp.close drop
        net.tcp.close drop
      ]
      [ drop net.tcp.close drop ]
      if
    ]
    [ drop ]
    if
;
