: connector ( -- )
    "127.0.0.1" 18264 net.tcp.connect
    [ net.tcp.close drop ]
    [ drop ]
    if
;

: test-close ( -- )
    18264 net.tcp.listen
    [ # ( server )
      [ connector ] strand.spawn drop
      dup net.tcp.accept
      [ # ( server client )
        dup net.tcp.read
        [ # success: ( server client data )
          string.length 0 test.assert-eq
        ]
        [ # hard failure: ( server client data )
          drop
          false test.assert
        ]
        if
        net.tcp.close drop
        net.tcp.close drop
      ]
      [ drop net.tcp.close drop ]
      if
    ]
    [ drop ]
    if
;
