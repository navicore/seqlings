# A one-shot echo server: accepts a single connection, echoes the
# client's bytes back, then returns.
#
# Ownership: this strand only owns the *accepted client* socket.
# The listener was copied to this strand via copy-on-spawn, but the
# parent strand remains the owner of the kernel handle and will
# close it after the test. We drop our stale copy without closing.
#
# A multi-connection echo server would loop on accept instead of
# returning after the first connection.
# seq:allow(unchecked-tcp-write)
: echo-server ( Socket -- )
    dup net.tcp.accept
    [ # ( server client )
      dup net.tcp.read
      [ # ( server client data )
        over net.tcp.write drop
      ]
      [ drop ]
      if
      net.tcp.close drop      # close the accepted client (we own this)
      drop                     # drop our stale copy of the listener
    ]
    [ # accept failed: ( server junk-client )
      drop drop                # drop both; parent will close the real listener
    ]
    if
;

# seq:allow(unchecked-tcp-write)
: test-echo ( -- )
    18265 net.tcp.listen
    [ # ( server )
      [ echo-server ] strand.spawn drop
      "127.0.0.1" 18265 net.tcp.connect
      [ # ( server client )
        "ping" over net.tcp.write drop
        dup net.tcp.read
        [ # ( server client data )
          "ping" test.assert-eq-str
        ]
        [ drop ]
        if
        net.tcp.close drop      # close our client side
      ]
      [ drop ]                  # connect failed
      if
      net.tcp.close drop        # close the listener — we own it
    ]
    [ drop ]                    # listen failed
    if
;
