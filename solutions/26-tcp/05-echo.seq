# seq:allow(unchecked-tcp-write)
: echo-server ( Socket -- )
    dup net.tcp.accept
    [ # ( server client )
      dup net.tcp.read
      [ # ( server client data )
        over net.tcp.write drop
      ]
      [ drop ]
      if
      net.tcp.close drop
      net.tcp.close drop
    ]
    [ drop net.tcp.close drop ]
    if
;

# seq:allow(unchecked-tcp-write)
: test-echo ( -- )
    18265 net.tcp.listen
    [ # ( server )
      [ echo-server ] strand.spawn drop
      drop
      "127.0.0.1" 18265 net.tcp.connect
      [ # ( client )
        "ping" over net.tcp.write drop
        dup net.tcp.read
        [ # ( client data )
          "ping" test.assert-eq-str
        ]
        [ drop ]
        if
        net.tcp.close drop
      ]
      [ drop ]
      if
    ]
    [ drop ]
    if
;
