: test-serial-baseline ( -- )
    chan.make   # work
    chan.make   # results

    [
        over chan.receive drop 10 time.sleep-ms 1 i.+ over chan.send drop
        over chan.receive drop 10 time.sleep-ms 1 i.+ over chan.send drop
        over chan.receive drop 10 time.sleep-ms 1 i.+ over chan.send drop
        drop drop
    ] strand.spawn drop

    time.now >aux

    over 1 swap chan.send drop
    over 1 swap chan.send drop
    over 1 swap chan.send drop

    dup chan.receive drop drop
    dup chan.receive drop drop
    dup chan.receive drop drop

    drop drop

    time.now aux> i.-

    30 >= test.assert
;
