: safe-gzip-roundtrip ( String -- String Bool )
    compress.gzip [
        compress.gunzip
    ] [
        drop "" false
    ] if
;

: safe-zstd-roundtrip ( String -- String Bool )
    compress.zstd [
        compress.unzstd
    ] [
        drop "" false
    ] if
;

: test-roundtrip ( -- )
    "The quick brown fox jumps over the lazy dog."
    safe-gzip-roundtrip
    test.assert
    "The quick brown fox jumps over the lazy dog." test.assert-eq-str

    "Pack my box with five dozen liquor jugs."
    safe-zstd-roundtrip
    test.assert
    "Pack my box with five dozen liquor jugs." test.assert-eq-str

    "" safe-gzip-roundtrip
    test.assert
    "" test.assert-eq-str
;
